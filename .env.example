# ==============================================================================
# SuAI Environment Configuration Template
# ==============================================================================
# IMPORTANT SECURITY NOTICE:
# - Provider keys must be stored ONLY on the server side.
# - NEVER prefix server keys with VITE_ (e.g. do NOT use VITE_GEMINI_API_KEY).
# - NEVER commit real credentials to version control.
# ==============================================================================

# Required: Google Gemini API Key from Google AI Studio (https://aistudio.google.com/)
# TIP: You can provide multiple keys separated by commas for automatic rotation & multiplied free quota!
# Example: GEMINI_API_KEY=AIzaSyKey1...,AIzaSyKey2...,AIzaSyKey3...
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Default AI Model (Defaults to gemini-3.8-flash if omitted)
# Supported production models: gemini-3.8-flash, gemini-2.5-flash
GEMINI_MODEL=gemini-3.8-flash

# Optional: Custom API Base URL for local development override (Leave blank for relative /api/chat in Vercel)
# VITE_API_URL=
